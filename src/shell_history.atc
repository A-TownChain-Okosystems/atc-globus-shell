// ============================================================================
// Module: shell_history
// Description: Persistent command history
// ATC-Standard: ATC-24
// Sprint: 3.1
// Language: ATCLang v0.3
// Created: 2026-08-20
// Agent: Aurora (MasterBrain · Base44)
// ============================================================================

module shell_history {

    // ------------------------------------------------------------------------
    // Configuration
    // ------------------------------------------------------------------------

    const MAX_ENTRIES: UInt64 = 1000
    const HISTORY_VERSION: UInt64 = 1

    // ------------------------------------------------------------------------
    // Primary struct
    // ------------------------------------------------------------------------

    struct History {
        id: UInt64,
        command: String,
        active: Bool,
        created_at: UInt64,
        updated_at: UInt64,
    }

    // ------------------------------------------------------------------------
    // Persistence struct
    // ------------------------------------------------------------------------

    struct HistoryStore {
        version: UInt64,
        next_id: UInt64,
        entries: Array<History>,
    }

    // ------------------------------------------------------------------------
    // Internal state
    // ------------------------------------------------------------------------

    var entries: Array<History> = []
    var next_id: UInt64 = 1
    var initialized: Bool = false
    var dirty: Bool = false

    // ------------------------------------------------------------------------
    // Initialize module
    // ------------------------------------------------------------------------

    fn init() -> Bool {

        if initialized == true {
            return true
        }

        entries = []
        next_id = 1
        dirty = false
        initialized = true

        load()

        return true
    }

    // ------------------------------------------------------------------------
    // Status
    // ------------------------------------------------------------------------

    fn status() -> String {

        if initialized == false {
            return "shell_history offline"
        }

        if dirty == true {
            return "shell_history ready · unsaved"
        }

        return "shell_history ready"
    }

    // ------------------------------------------------------------------------
    // Timestamp
    // ------------------------------------------------------------------------

    fn timestamp() -> UInt64 {
        return system.time.unix()
    }

    // ------------------------------------------------------------------------
    // Validate command
    // ------------------------------------------------------------------------

    fn valid_command(command: String) -> Bool {

        if command == "" {
            return false
        }

        return true
    }

    // ------------------------------------------------------------------------
    // Add command
    // ------------------------------------------------------------------------

    fn add(command: String) -> Bool {

        if initialized == false {
            return false
        }

        if valid_command(command) == false {
            return false
        }

        let now: UInt64 = timestamp()

        let entry = History {
            id: next_id,
            command: command,
            active: true,
            created_at: now,
            updated_at: now,
        }

        entries.push(entry)

        next_id = next_id + 1
        dirty = true

        trim()

        return true
    }

    // ------------------------------------------------------------------------
    // Trim history
    // ------------------------------------------------------------------------

    fn trim() -> Bool {

        while entries.length() > MAX_ENTRIES {
            entries.remove_first()
        }

        return true
    }

    // ------------------------------------------------------------------------
    // Search
    // ------------------------------------------------------------------------

    fn search(query: String) -> String {

        if initialized == false {
            return ""
        }

        if query == "" {
            return ""
        }

        var result: String = ""

        for entry in entries {

            if entry.active == false {
                continue
            }

            if entry.command.contains(query) {

                result = result
                    + entry.id.to_string()
                    + ": "
                    + entry.command
                    + "\n"
            }
        }

        return result
    }

    // ------------------------------------------------------------------------
    // Recall by immutable ID
    // ------------------------------------------------------------------------

    fn recall(id: UInt64) -> String {

        if initialized == false {
            return ""
        }

        for entry in entries {

            if entry.id == id {

                if entry.active == true {
                    return entry.command
                }

                return ""
            }
        }

        return ""
    }

    // ------------------------------------------------------------------------
    // Get entry
    // ------------------------------------------------------------------------

    fn get(id: UInt64) -> String {

        if initialized == false {
            return ""
        }

        for entry in entries {

            if entry.id == id {

                return entry.id.to_string()
                    + "|"
                    + entry.command
                    + "|"
                    + entry.active.to_string()
                    + "|"
                    + entry.created_at.to_string()
                    + "|"
                    + entry.updated_at.to_string()
            }
        }

        return ""
    }

    // ------------------------------------------------------------------------
    // Remove entry
    // ------------------------------------------------------------------------

    fn remove(id: UInt64) -> Bool {

        if initialized == false {
            return false
        }

        for i in 0..entries.length() {

            if entries[i].id == id {

                if entries[i].active == false {
                    return false
                }

                entries[i].active = false
                entries[i].updated_at = timestamp()

                dirty = true

                return true
            }
        }

        return false
    }

    // ------------------------------------------------------------------------
    // Clear history
    // ------------------------------------------------------------------------

    fn clear() -> Bool {

        if initialized == false {
            return false
        }

        let now: UInt64 = timestamp()

        for i in 0..entries.length() {

            if entries[i].active == true {

                entries[i].active = false
                entries[i].updated_at = now
            }
        }

        dirty = true

        return true
    }

    // ------------------------------------------------------------------------
    // Count active entries
    // ------------------------------------------------------------------------

    fn count() -> UInt64 {

        if initialized == false {
            return 0
        }

        var total: UInt64 = 0

        for entry in entries {

            if entry.active == true {
                total = total + 1
            }
        }

        return total
    }

    // ------------------------------------------------------------------------
    // Count all entries
    // ------------------------------------------------------------------------

    fn total() -> UInt64 {

        if initialized == false {
            return 0
        }

        return entries.length()
    }

    // ------------------------------------------------------------------------
    // First active command
    // ------------------------------------------------------------------------

    fn first() -> String {

        if initialized == false {
            return ""
        }

        for entry in entries {

            if entry.active == true {
                return entry.command
            }
        }

        return ""
    }

    // ------------------------------------------------------------------------
    // Last active command
    // ------------------------------------------------------------------------

    fn last() -> String {

        if initialized == false {
            return ""
        }

        var i: UInt64 = entries.length()

        while i > 0 {

            i = i - 1

            if entries[i].active == true {
                return entries[i].command
            }
        }

        return ""
    }

    // ------------------------------------------------------------------------
    // List active history
    // ------------------------------------------------------------------------

    fn list() -> String {

        if initialized == false {
            return ""
        }

        var result: String = ""

        for entry in entries {

            if entry.active == true {

                result = result
                    + entry.id.to_string()
                    + ": "
                    + entry.command
                    + "\n"
            }
        }

        return result
    }

    // ------------------------------------------------------------------------
    // Export history
    // ------------------------------------------------------------------------

    fn export() -> String {

        if initialized == false {
            return ""
        }

        var result: String = ""

        result = result
            + "ATC-24-HISTORY\n"
            + "VERSION="
            + HISTORY_VERSION.to_string()
            + "\n"
            + "NEXT_ID="
            + next_id.to_string()
            + "\n"

        for entry in entries {

            result = result
                + entry.id.to_string()
                + "|"
                + entry.command
                + "|"
                + entry.active.to_string()
                + "|"
                + entry.created_at.to_string()
                + "|"
                + entry.updated_at.to_string()
                + "\n"
        }

        return result
    }

    // ------------------------------------------------------------------------
    // Save history
    // ------------------------------------------------------------------------

    fn save() -> Bool {

        if initialized == false {
            return false
        }

        let data: String = export()

        let result = system.storage.write(
            "atc/shell/history",
            data
        )

        if result == false {
            return false
        }

        dirty = false

        return true
    }

    // ------------------------------------------------------------------------
    // Load history
    // ------------------------------------------------------------------------

    fn load() -> Bool {

        if initialized == false {
            return false
        }

        let data: String = system.storage.read(
            "atc/shell/history"
        )

        if data == "" {
            return true
        }

        let lines: Array<String> = data.split("\n")

        for line in lines {

            if line == "" {
                continue
            }

            if line == "ATC-24-HISTORY" {
                continue
            }

            if line.starts_with("VERSION=") {
                continue
            }

            if line.starts_with("NEXT_ID=") {

                next_id = line
                    .replace("NEXT_ID=", "")
                    .to_uint64()

                continue
            }

            let parts: Array<String> = line.split("|")

            if parts.length() < 5 {
                continue
            }

            let entry = History {
                id: parts[0].to_uint64(),
                command: parts[1],
                active: parts[2].to_bool(),
                created_at: parts[3].to_uint64(),
                updated_at: parts[4].to_uint64(),
            }

            entries.push(entry)
        }

        trim()

        dirty = false

        return true
    }

    // ------------------------------------------------------------------------
    // Import history
    // ------------------------------------------------------------------------

    fn import(data: String) -> Bool {

        if initialized == false {
            return false
        }

        if data == "" {
            return false
        }

        let lines: Array<String> = data.split("\n")

        entries = []
        next_id = 1

        for line in lines {

            if line == "" {
                continue
            }

            if line == "ATC-24-HISTORY" {
                continue
            }

            if line.starts_with("VERSION=") {
                continue
            }

            if line.starts_with("NEXT_ID=") {

                next_id = line
                    .replace("NEXT_ID=", "")
                    .to_uint64()

                continue
            }

            let parts: Array<String> = line.split("|")

            if parts.length() < 5 {
                continue
            }

            let entry = History {
                id: parts[0].to_uint64(),
                command: parts[1],
                active: parts[2].to_bool(),
                created_at: parts[3].to_uint64(),
                updated_at: parts[4].to_uint64(),
            }

            entries.push(entry)
        }

        trim()

        dirty = true

        return true
    }

    // ------------------------------------------------------------------------
    // Shutdown
    // ------------------------------------------------------------------------

    fn shutdown() -> Bool {

        if initialized == false {
            return false
        }

        if dirty == true {

            if save() == false {
                return false
            }
        }

        initialized = false

        return true
    }

} // module shell_history